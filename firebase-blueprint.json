{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Cadastro clínico de um paciente acompanhado pela nutricionista.",
      "type": "object",
      "properties": {
        "nutritionistId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID da nutricionista proprietária do prontuário."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Nome completo do paciente."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "E-mail de contato do paciente (PII)."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Telefone ou WhatsApp do paciente (PII)."
        },
        "birthYear": {
          "type": "integer",
          "description": "Ano de nascimento do paciente (1920 a 2026)."
        },
        "sex": {
          "type": "string",
          "enum": ["F", "M"],
          "description": "Sexo biológico usado nos cálculos de TMB."
        },
        "weightKg": {
          "type": "number",
          "description": "Peso atual em quilogramas."
        },
        "heightCm": {
          "type": "number",
          "description": "Altura em centímetros."
        },
        "activityLevel": {
          "type": "string",
          "enum": ["sedentario", "leve", "moderado", "intenso", "atleta"],
          "description": "Nível de atividade física semanal."
        },
        "goal": {
          "type": "string",
          "enum": ["emagrecimento", "hipertrofia", "reeducacao", "controle_glicemico", "performance"],
          "description": "Objetivo nutricional principal."
        },
        "restrictions": {
          "type": "array",
          "description": "Lista limitada (máx. 15) de alergias ou restrições alimentares."
        },
        "clinicalNotes": {
          "type": "string",
          "maxLength": 1500,
          "description": "Observações clínicas e resumo da anamnese."
        },
        "targetCalories": {
          "type": "number",
          "description": "Meta diária de energia em kcal."
        },
        "targetProteinG": {
          "type": "number",
          "description": "Meta diária de proteínas em gramas."
        },
        "targetCarbsG": {
          "type": "number",
          "description": "Meta diária de carboidratos em gramas."
        },
        "targetFatG": {
          "type": "number",
          "description": "Meta diária de gorduras em gramas."
        },
        "waterTargetLiters": {
          "type": "number",
          "description": "Meta diária de hidratação em litros."
        },
        "status": {
          "type": "string",
          "enum": ["ativo", "em_acompanhamento", "arquivado"],
          "description": "Status de acompanhamento do paciente."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor no momento da criação."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na última atualização."
        }
      },
      "required": [
        "nutritionistId",
        "fullName",
        "email",
        "phone",
        "birthYear",
        "sex",
        "weightKg",
        "heightCm",
        "activityLevel",
        "goal",
        "restrictions",
        "clinicalNotes",
        "targetCalories",
        "targetProteinG",
        "targetCarbsG",
        "targetFatG",
        "waterTargetLiters",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Receita clínica da biblioteca da nutricionista com informações nutricionais por porção.",
      "type": "object",
      "properties": {
        "nutritionistId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID da nutricionista proprietária da receita."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Título da receita."
        },
        "category": {
          "type": "string",
          "enum": ["cafe_da_manha", "almoco", "jantar", "lanche", "ceia", "sobremesa_fit"],
          "description": "Refeição principal para a qual a receita é indicada."
        },
        "description": {
          "type": "string",
          "maxLength": 400,
          "description": "Resumo da preparação e benefícios nutricionais."
        },
        "prepTimeMin": {
          "type": "integer",
          "description": "Tempo estimado de preparo em minutos."
        },
        "servings": {
          "type": "integer",
          "description": "Rendimento em porções."
        },
        "portionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Medida caseira da porção (ex: 1 tigela de 320g)."
        },
        "calories": {
          "type": "number",
          "description": "Calorias por porção (kcal)."
        },
        "proteinG": {
          "type": "number",
          "description": "Proteínas por porção (g)."
        },
        "carbsG": {
          "type": "number",
          "description": "Carboidratos por porção (g)."
        },
        "fatG": {
          "type": "number",
          "description": "Gorduras por porção (g)."
        },
        "fiberG": {
          "type": "number",
          "description": "Fibras por porção (g)."
        },
        "dietaryTags": {
          "type": "array",
          "description": "Etiquetas nutricionais (máx. 10)."
        },
        "ingredients": {
          "type": "array",
          "description": "Lista de ingredientes com quantidades (máx. 30)."
        },
        "instructions": {
          "type": "array",
          "description": "Passos do modo de preparo (máx. 20)."
        },
        "clinicalTip": {
          "type": "string",
          "maxLength": 500,
          "description": "Dica de substituição ou orientação clínica."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Caminho local da foto da receita."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na criação."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor na atualização."
        }
      },
      "required": [
        "nutritionistId",
        "title",
        "category",
        "description",
        "prepTimeMin",
        "servings",
        "portionLabel",
        "calories",
        "proteinG",
        "carbsG",
        "fatG",
        "fiberG",
        "dietaryTags",
        "ingredients",
        "instructions",
        "clinicalTip",
        "imageUrl",
        "createdAt",
        "updatedAt"
      ]
    },
